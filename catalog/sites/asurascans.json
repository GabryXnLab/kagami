{
  "format": 2,
  "id": "asurascans",
  "name": "Asura Scans",
  "version": 4,
  "home": "https://asurascans.com",
  "hosts": ["asurascans.com", "www.asurascans.com", "api.asurascans.com"],
  "mediaHosts": ["cdn.asurascans.com"],
  "series": {
    "path": "^/comics/([a-z0-9-]+)/?$",
    "linkVars": {
      "segment": {"from": "page", "regex": "^https://[^/]+/comics/([a-z0-9-]+)"},
      "slug": {
        "from": "page",
        "regex": "^https://[^/]+/comics/([a-z0-9-]+)",
        "filters": [{"replace": ["-[0-9a-f]{8}$", ""]}]
      }
    },
    "url": {
      "try": [
        "https://api.asurascans.com/api/series/{slug}",
        "https://api.asurascans.com/api/series/{segment}"
      ],
      "on": [404]
    },
    "json": true,
    "vars": {
      "s": {"first": [{"json": "series"}, {"json": "data.series"}]}
    },
    "link": "https://asurascans.com/comics/{slug}",
    "id": {"var": "s", "json": "slug"},
    "title": {"var": "s", "json": "title"},
    "cover": {"var": "s", "json": "cover"},
    "description": {"var": "s", "json": "description", "html": true},
    "status": {"var": "s", "json": "status"},
    "type": {"var": "s", "json": "type"},
    "genres": {"var": "s", "json": "genres.name", "all": true},
    "authors": {"var": "s", "json": "author"},
    "artists": {"var": "s", "json": "artist"},
    "alternativeTitles": {"first": [
      {"var": "s", "json": "alt_titles", "all": true},
      {"var": "s", "json": "alternative_titles"}
    ]},
    "chapters": {
      "api": "https://api.asurascans.com/api/series/{id}/chapters",
      "items": {"json": "data"},
      "order": "newest-first",
      "vars": {
        "n": {"json": "number", "filters": ["number"]},
        "t": {"json": "title"},
        "chapterSlug": {"json": "slug"},
        "seriesSlug": {"json": "series_slug"}
      },
      "keep": ["chapterSlug", "seriesSlug"],
      "skip": [{"json": "is_premium", "equals": true}],
      "id": {"json": "id"},
      "number": {"var": "n"},
      "title": {"first": [{"template": "Chapter {n} - {t}"}, {"template": "Chapter {n}"}]},
      "url": {"template": "https://asurascans.com/comics/{id}/chapter/{n}"}
    }
  },
  "chapter": {
    "path": "^/comics/([a-z0-9-]+)/chapter/[0-9]+(?:\\.[0-9]+)?/?$",
    "api": "https://api.asurascans.com/api/series/{seriesSlug}/chapters/{chapterSlug}",
    "require": [{"json": "data.chapter.id", "equals": "{chapterId}"}],
    "locked": {"json": "data.is_locked", "equals": true},
    "pages": {
      "items": {"json": "data.chapter.pages"},
      "url": {"json": "url"},
      "width": {"json": "width"},
      "height": {"json": "height"}
    }
  },
  "search": {
    "url": {"template": "https://api.asurascans.com/api/search", "query": {"q": "{query}"}},
    "json": true,
    "items": {"json": "data"},
    "skip": [{"json": "type", "equals": "novel"}],
    "title": {"json": "title"},
    "link": {"json": "slug", "base": "https://asurascans.com/comics/"},
    "cover": {"first": [{"json": "cover"}, {"json": "cover_url"}]},
    "latest": {"json": "latest_chapters[0].number"},
    "status": {"json": "status"}
  }
}
